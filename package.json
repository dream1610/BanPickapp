{
  "name": "veto-protocol",
  "version": "1.0.0",
  "description": "Veto Protocol map draft companion",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test tests",
    "dev": "vite",
    "dev:server": "node --watch server/app.js",
    "dev:full": "concurrently -k \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "build:desktop": "vite build --base=./ && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-brand-assets.ps1 && electron-builder --win nsis --x64",
    "pack:desktop": "vite build --base=./ && electron-builder --dir --win --x64",
    "build:android:apk": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-brand-assets.ps1 && npx cap sync android && android\\gradlew.bat -p android assembleDebug && node scripts/copy-android-apk.mjs",
    "build:installers": "npm run build:desktop && npm run build:android:apk",
    "preview": "vite preview",
    "start": "node server/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "concurrently": "^10.0.7",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morphdom": "^2.7.8",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "build": {
    "appId": "com.gdreed.draftconsole",
    "productName": "Veto Protocol",
    "directories": {
      "output": "installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "artifactName": "Veto-Protocol-${version}-${arch}-Setup.${ext}",
    "win": {
      "icon": "build/veto-protocol.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "installerIcon": "build/veto-protocol.ico",
      "uninstallerIcon": "build/veto-protocol.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
